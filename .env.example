# =============================================================================
# FinRPA Enterprise -- Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
ENV=local
LOG_LEVEL=INFO
PORT=8000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_STRING=postgresql+psycopg://skyvern:skyvern@localhost:5432/skyvern

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# --- OpenAI ---
ENABLE_OPENAI=false
OPENAI_API_KEY=
# LLM_KEY=OPENAI_GPT4O

# --- Anthropic ---
ENABLE_ANTHROPIC=false
ANTHROPIC_API_KEY=
# LLM_KEY=ANTHROPIC_CLAUDE3.5_SONNET

# --- Azure OpenAI ---
ENABLE_AZURE=false
AZURE_DEPLOYMENT=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# --- Primary & Secondary model keys ---
LLM_KEY=
SECONDARY_LLM_KEY=

# -----------------------------------------------------------------------------
# Browser Configuration
# -----------------------------------------------------------------------------
BROWSER_TYPE=chromium-headful
MAX_SCRAPING_RETRIES=0
VIDEO_PATH=./videos
BROWSER_ACTION_TIMEOUT_MS=5000
MAX_STEPS_PER_RUN=50

# -----------------------------------------------------------------------------
# Enterprise: JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Enterprise: Phase 2 Action Governance (audit-only is non-blocking)
# -----------------------------------------------------------------------------
GOVERNANCE_MODE=off
# `enforce` is intentionally rejected until every browser execution path is
# sealed by the one-time ExecutionPermit boundary. Use `audit` for Phase 2 data collection.
GOVERNANCE_AUDIT_HMAC_SECRET=
ENABLE_GOVERNANCE_RECOVERY_SCHEDULER=false
ENABLE_GOVERNANCE_RECOVERY_EXECUTION=false
GOVERNANCE_RECOVERY_INTERVAL_SECONDS=30
GOVERNANCE_RECOVERY_BATCH_SIZE=20

# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
ANALYTICS_ID=anonymous
