# AgentPact local runtime
DATABASE_STRING=postgresql+asyncpg://skyvern:skyvern@127.0.0.1:5432/skyvern
REDIS_URL=redis://127.0.0.1:6379/0

# Enterprise authentication
SECRET_KEY=replace-with-a-random-secret
SIGNATURE_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Governance is fail-closed. Enforce mode is not available yet.
GOVERNANCE_MODE=off
GOVERNANCE_AUDIT_HMAC_SECRET=
ENABLE_GOVERNANCE_RECOVERY_SCHEDULER=false

# Agent Run planning defaults to deterministic recorded mode.
AGENT_RUN_PROVIDER_MODE=recorded
AGENT_RUN_PROVIDER_TIMEOUT_SECONDS=30

# Required only when AGENT_RUN_PROVIDER_MODE=live.
OPENAI_COMPATIBLE_API_BASE=
OPENAI_COMPATIBLE_MODEL_NAME=
OPENAI_COMPATIBLE_API_KEY=
